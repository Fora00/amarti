# Copy to `.env` (git-ignored). Everything here is PUBLIC: Astro bundles every
# PUBLIC_ variable into the browser JavaScript, so only values that are safe for
# the whole internet belong in this file.
#
# NEVER put the service-role / secret key here. The build refuses to run if it
# finds one in a PUBLIC_ variable (env-guard.mjs).

# `mock` = sample data kept in the browser, no backend (default, safe for demos).
# `supabase` = the real database. Switch only after the project exists.
PUBLIC_DATA_MODE=mock

# Supabase → Project settings → API. The URL, and the *anon / publishable* key
# (the long `eyJ…` one labelled "anon public", or `sb_publishable_…`).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
