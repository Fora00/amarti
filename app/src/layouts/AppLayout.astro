---
import "../styles/global.css";
import Logo from "../../../site/src/components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

/**
 * The dashboard frame. Since 2026-11-27 it has the SAME top bar as the public
 * site (logo left, plain text links right, light/dark toggle) instead of the
 * design-system AppShell with its phone tab bar: the user wanted one look and
 * no bar at the bottom. Every section is one click away in the top bar, with a
 * badge for what needs her attention; "Esci" lives there too (no session block
 * at the bottom of each page any more).
 *
 * The logo is the site's own component (one tracing, two packages: the app
 * already reads the site's content the same way).
 */
interface Props { title: string; active?: "corsi" | "sala" | "richieste" | "listino" | "account" | ""; eyebrow?: string; plain?: boolean }
const { title, active = "", eyebrow, plain = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// One line each, so she knows where to go: what the section is FOR, not just its name.
const nav = [
  { id: "corsi", label: "Corsi e iscritti", href: `${base}/` },
  { id: "sala", label: "Sala", href: `${base}/sala/` },
  { id: "richieste", label: "Messaggi", href: `${base}/richieste/` },
  { id: "listino", label: "Listino prezzi", href: `${base}/listino/` },
  { id: "account", label: "Password", href: `${base}/account/` },
] as const;
// The public site: the dashboard lives at <site>/dashboard/ on Pages, so drop the last segment.
const siteHref = `${base.replace(/\/dashboard$/, "")}/`;
const linkClass = "text-sm font-semibold text-ink-muted no-underline hover:text-accent";
---

<html lang="it" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- Light unless dark was chosen with the toggle (site or app, same storage key). Before paint. -->
    <script is:inline>try{if(localStorage.getItem("amarti-theme")==="dark")document.documentElement.dataset.theme="dark"}catch{}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Private app: behind a login, never to be indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <title>{title} · Dashboard aMarti ceramics</title>
  </head>
  <body>
    <header class="border-b border-line bg-surface">
      <nav class="mx-auto flex max-w-[46rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3" aria-label="Dashboard">
        <a href={`${base}/`} class="flex items-center gap-3 text-ink no-underline">
          <Logo class="h-7 w-auto" />
          <span class="text-sm font-semibold text-ink-muted">Dashboard</span>
        </a>
        <ul class="flex list-none flex-wrap items-center gap-x-5 gap-y-2 p-0 m-0">
          {!plain && nav.map((n) => (
            <li>
              <a href={n.href} class:list={[linkClass, "app-nav-link"]} aria-current={active === n.id ? "page" : undefined}>
                {n.label}<span class="tab-badge app-badge" data-badge-for={n.id} hidden></span>
              </a>
            </li>
          ))}
          <li><a href={siteHref} class={linkClass}>Sito ↗</a></li>
          {!plain && <li><button type="button" id="sign-out" class={`${linkClass} app-signout`} hidden>Esci</button></li>}
          <li class="flex"><ThemeToggle /></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <div class="pagehead">
        <div>
          <p class="eyebrow" id="eyebrow" hidden={!eyebrow}>{eyebrow}</p>
          <h1>{title}</h1>
        </div>
        <div class="actions-slot"><slot name="actions" /></div>
      </div>
      <p id="status" role="status"></p>
      <slot />
    </main>

    {!plain && (
      <script>
        // Badges: new sign-ups (still `iscritta`) on Corsi, open messages on
        // Messaggi. "Esci" once signed in. Silent on failure; RLS answers 0 rows
        // before login anyway.
        import { configured, supabase } from "../lib/supabase";
        import { data } from "../lib/data";
        const fill = (tab: string, n: number) => {
          const badge = document.querySelector<HTMLElement>(`[data-badge-for="${tab}"]`);
          if (badge) { badge.textContent = n > 99 ? "99+" : String(n); badge.hidden = n === 0; }
        };
        if (configured) {
          data.countNewSignups().then((n) => fill("corsi", n)).catch(() => {});
          data.countOpenInbox().then((n) => fill("richieste", n)).catch(() => {});
          data.countNewRoomRequests().then((n) => fill("sala", n)).catch(() => {});
          const out = document.querySelector<HTMLButtonElement>("#sign-out");
          supabase.auth.getSession().then(({ data: s }) => {
            if (!out || !s.session) return;
            out.hidden = false;
            out.addEventListener("click", async () => {
              out.disabled = true;
              await supabase.auth.signOut();
              location.assign(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/login/`);
            });
          }).catch(() => {});
        }
      </script>
    )}
  </body>
</html>

<style is:global>
  /* No bottom tab bar any more: the room it kept free under the page goes. */
  main { padding-bottom: 3rem; }
  .app-nav-link { position: relative; display: inline-flex; align-items: center; gap: .35rem; }
  .app-nav-link[aria-current="page"] { color: var(--accent); text-decoration: underline; text-underline-offset: .35em; text-decoration-thickness: 2px; }
  .app-badge { position: static; }
  .app-badge[hidden] { display: none; }
  .app-signout { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; }
</style>
