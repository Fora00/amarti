---
import "../styles/global.css";
import AppShell from "@factory/design-system/components/AppShell.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props { title: string; active?: "corsi" | "richieste" | ""; eyebrow?: string; plain?: boolean }
const { title, active = "", eyebrow, plain = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Add a tab here when you add a page: { id, label, href, icon } (icons: today, dogs, inbox, hours, more).
const nav = [
  { id: "corsi", label: "Corsi", href: `${base}/`, icon: "today" },
  { id: "richieste", label: "Richieste", href: `${base}/richieste/`, icon: "inbox" },
] as const;
// The public site: the app lives at <site>/app/ on Pages, so drop the last segment.
const siteHref = `${base.replace(/\/app$/, "")}/`;
---

<html lang="it" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- Light unless dark was chosen with the toggle (site or app, same storage key). Before paint. -->
    <script is:inline>try{if(localStorage.getItem("amarti-theme")==="dark")document.documentElement.dataset.theme="dark"}catch{}</script>
    <!-- viewport-fit=cover: the whole screen of an installed app; the CSS keeps clear of the notch -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Private app: behind a login, never to be indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <!-- Installable app (PWA): see annina/app for the manifest, the service worker and the icons;
         the pieces are in @factory/common/pwa, @factory/common/pwa-client and `pnpm pwa-icons`. -->
    <title>{title} · Area aMarti ceramics</title>
  </head>
  <body>
    <AppShell
      title={title} eyebrow={eyebrow} active={active} nav={plain ? [] : [...nav]} brand="aMarti ceramics · Area riservata" homeHref={`${base}/`}>
      <div slot="actions" class="layout-actions">
        <slot name="actions" />
        <a href={siteHref} class="btn small secondary">← Sito</a>
        <ThemeToggle />
      </div>
      <slot />
    </AppShell>
    {!plain && (
      <script>
        // Tab badges: new sign-ups (still `iscritta`) on Corsi, open messages on
        // Richieste. Silent on failure; RLS answers 0 rows before login anyway.
        import { configured } from "../lib/supabase";
        import { data } from "../lib/data";
        const fill = (tab: string, n: number) => {
          const badge = document.querySelector<HTMLElement>(`[data-badge-for="${tab}"]`);
          if (badge) { badge.textContent = n > 99 ? "99+" : String(n); badge.hidden = n === 0; }
        };
        if (configured) {
          data.countNewSignups().then((n) => fill("corsi", n)).catch(() => {});
          data.countOpenInbox().then((n) => fill("richieste", n)).catch(() => {});
        }
      </script>
    )}
  </body>
</html>

<style>
  .layout-actions { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; justify-content: flex-end; }
</style>
