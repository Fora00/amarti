---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Accesso" plain>
  <p class="muted" id="intro">Entra con email e password. Primo accesso o password dimenticata? Ricevi un codice via email.</p>
  <form id="login" class="card" style="max-width:24rem;margin-top:1rem">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" class="input" required autocomplete="username" />
    </div>
    <div class="field" style="margin-top:.75rem">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" class="input" autocomplete="current-password" />
    </div>
    <div class="row" style="margin-top:1rem;justify-content:flex-start;flex-wrap:wrap;gap:.5rem">
      <button class="btn" type="submit">Entra</button>
      <button class="btn secondary" type="button" id="magic">Inviami un codice via email</button>
    </div>
  </form>
  <form id="code-form" class="card" style="max-width:24rem;margin-top:1rem" hidden>
    <div class="field">
      <label for="code">Codice ricevuto via email</label>
      <input id="code" name="code" class="input" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" maxlength="10" required />
    </div>
    <div style="margin-top:1rem"><button class="btn" type="submit">Entra con il codice</button></div>
  </form>

  <script>
    import { configured, problem, supabase } from "../../lib/supabase";
    import { $, href, say } from "../../lib/ui";
    import { attempt } from "../../lib/views";

    // Back from an OLD email link (before codes) that no longer works: Supabase puts the reason in
    // the hash (#error=access_denied&error_code=otp_expired…). Each new email
    // cancels the previous link, and a link lasts one hour.
    const hash = new URLSearchParams(location.hash.slice(1));
    if (hash.get("error")) {
      say("Questo link di accesso non è più valido: ogni nuova email annulla quella prima, e un link dura un'ora. Usa l'ultima email ricevuta, oppure chiedine una nuova.", true);
      history.replaceState(null, "", location.pathname + location.search);
    }

    if (new URLSearchParams(location.search).has("negato")) {
      say("Questo indirizzo non ha accesso alla dashboard.", true);
    }

    const email = () => $<HTMLInputElement>("#email").value.trim().toLowerCase();

    if (!configured) {
      // No Supabase project in this build: there is nothing to sign in to.
      $("#login").remove();
      $("#intro").hidden = true;
      say(problem ?? "Dashboard non configurata.", true);
    } else {
      // Already signed in on this browser (the session is kept in localStorage
      // and refreshed by supabase-js): go straight to the dashboard. `?negato`
      // means the guard just signed a non-staff account out — stay here then.
      if (!new URLSearchParams(location.search).has("negato")) {
        void supabase.auth.getSession().then(({ data }) => {
          if (data.session) location.replace(href("/"));
        });
      }

      // Email + password: no email is sent, so no mailer rate limit. The
      // password is set once from /account/ after a first sign-in by link; the
      // browser / iCloud Keychain then fills it in.
      $<HTMLFormElement>("#login").addEventListener("submit", (ev) => {
        ev.preventDefault();
        const password = $<HTMLInputElement>("#password").value;
        void attempt(async () => {
          if (!password) throw new Error("Scrivi la password, oppure usa «Inviami un codice via email».");
          const { error } = await supabase.auth.signInWithPassword({ email: email(), password });
          if (error) {
            if (error.status === 429) throw new Error("Troppi tentativi: aspetta qualche minuto e riprova.");
            throw new Error("Email o password non corretti. Se non hai ancora una password, usa «Inviami un codice via email».");
          }
          location.replace(href("/"));
        });
      });

      // Email code (the magic-link email, whose template shows {{ .Token }}):
      // first sign-in on a device, or a forgotten password. Typed here, so it
      // also works inside an installed home-screen app.
      $<HTMLButtonElement>("#magic").addEventListener("click", () => {
        const form = $<HTMLFormElement>("#login");
        if (!$<HTMLInputElement>("#email").checkValidity()) { form.reportValidity(); return; }
        void attempt(async () => {
          const { error } = await supabase.auth.signInWithOtp({
            email: email(),
            // `shouldCreateUser: false`: only an account that already exists can sign in.
            options: { shouldCreateUser: false },
          });
          if (error) {
            // Supabase's built-in mailer allows only a few emails per hour per project.
            if (error.status === 429 || /rate limit/i.test(error.message)) {
              throw new Error("Troppe email di accesso in poco tempo: aspetta un po' (fino a un'ora) e riprova. Se hai già ricevuto un codice, usa il più recente.");
            }
            if (/signups not allowed|user not found/i.test(error.message)) {
              throw new Error("Questo indirizzo non ha accesso alla dashboard.");
            }
            throw new Error("Non è stato possibile inviare il codice. Controlla l'indirizzo e riprova.");
          }
          say("Ti abbiamo inviato un codice via email (guarda anche nello spam): scrivilo qui sotto. Vale l'ultimo ricevuto.");
          $<HTMLFormElement>("#code-form").hidden = false;
          $<HTMLInputElement>("#code").focus();
        });
      });

      $<HTMLFormElement>("#code-form").addEventListener("submit", (ev) => {
        ev.preventDefault();
        const token = $<HTMLInputElement>("#code").value.replace(/\s/g, "");
        void attempt(async () => {
          const { error } = await supabase.auth.verifyOtp({ email: email(), token, type: "email" });
          if (error) throw new Error("Codice non valido o scaduto: controlla di usare l'ultimo ricevuto, oppure chiedine uno nuovo.");
          // First time in: suggest a password so the next sign-in needs no email.
          location.replace(href("/account/?benvenuta=1"));
        });
      });
    }
  </script>
</AppLayout>
