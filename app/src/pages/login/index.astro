---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Accesso" plain>
  <p class="muted" id="intro">Inserisci la tua email: ti inviamo un link per entrare, senza password.</p>
  <form id="login" class="card" style="max-width:24rem;margin-top:1rem">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" class="input" required autocomplete="email" />
    </div>
    <div style="margin-top:1rem"><button class="btn" type="submit">Inviami il link di accesso</button></div>
  </form>

  <script>
    import { configured, problem, supabase } from "../../lib/supabase";
    import { $, href, say } from "../../lib/ui";
    import { attempt } from "../../lib/views";

    // Back from an email link that no longer works: Supabase puts the reason in
    // the hash (#error=access_denied&error_code=otp_expired…). Each new email
    // cancels the previous link, and a link lasts one hour.
    const hash = new URLSearchParams(location.hash.slice(1));
    if (hash.get("error")) {
      say("Questo link di accesso non è più valido: ogni nuova email annulla quella prima, e un link dura un'ora. Usa l'ultima email ricevuta, oppure chiedine una nuova.", true);
      history.replaceState(null, "", location.pathname + location.search);
    }

    if (new URLSearchParams(location.search).has("negato")) {
      say("Questo indirizzo non ha accesso alla dashboard.", true);
    }

    if (!configured) {
      // No Supabase project in this build: there is nothing to sign in to.
      $("#login").remove();
      $("#intro").hidden = true;
      say(problem ?? "Dashboard non configurata.", true);
    } else {
      // Already signed in on this browser (the session is kept in localStorage
      // and refreshed by supabase-js): go straight to the dashboard. `?negato`
      // means the guard just signed a non-staff account out — stay here then.
      if (!new URLSearchParams(location.search).has("negato")) {
        void supabase.auth.getSession().then(({ data }) => {
          if (data.session) location.replace(href("/"));
        });
      }
      $<HTMLFormElement>("#login").addEventListener("submit", (ev) => {
        ev.preventDefault();
        const email = $<HTMLInputElement>("#email").value.trim().toLowerCase();
        void attempt(async () => {
          const { error } = await supabase.auth.signInWithOtp({
            email,
            // `shouldCreateUser: false`: only an account that already exists can sign in.
            options: { shouldCreateUser: false, emailRedirectTo: `${location.origin}${href("/")}` },
          });
          if (error) {
            // Supabase's built-in mailer allows only a few emails per hour per project.
            if (error.status === 429 || /rate limit/i.test(error.message)) {
              throw new Error("Troppe email di accesso in poco tempo: aspetta un po' (fino a un'ora) e riprova. Se hai già ricevuto un'email, usa il link più recente.");
            }
            if (/signups not allowed|user not found/i.test(error.message)) {
              throw new Error("Questo indirizzo non ha accesso alla dashboard.");
            }
            throw new Error("Non è stato possibile inviare il link. Controlla l'indirizzo e riprova.");
          }
          say("Controlla la tua email (anche nello spam): ti abbiamo inviato il link di accesso. Usa l'ultima email ricevuta: le precedenti non valgono più.");
        });
      });
    }
  </script>
</AppLayout>
