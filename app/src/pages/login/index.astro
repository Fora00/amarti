---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Accesso" plain>
  <p class="muted" id="intro">Inserisci la tua email: ti inviamo un link per entrare, senza password.</p>
  <form id="login" class="card" style="max-width:24rem;margin-top:1rem">
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" class="input" required autocomplete="email" />
    </div>
    <div style="margin-top:1rem"><button class="btn" type="submit">Inviami il link di accesso</button></div>
  </form>

  <script>
    import { mode, supabase } from "../../lib/supabase";
    import { $, href, say } from "../../lib/ui";
    import { attempt } from "../../lib/views";

    if (new URLSearchParams(location.search).has("negato")) {
      say("Questo indirizzo non ha accesso all'area riservata.", true);
    }

    if (mode === "mock") {
      // The demo has no accounts: nothing private is in it.
      $("#login").remove();
      $("#intro").textContent = "Modalità demo: non serve accedere.";
    } else {
      $<HTMLFormElement>("#login").addEventListener("submit", (ev) => {
        ev.preventDefault();
        const email = $<HTMLInputElement>("#email").value.trim().toLowerCase();
        void attempt(async () => {
          const { error } = await supabase.auth.signInWithOtp({
            email,
            // `shouldCreateUser: false`: only an account that already exists can sign in.
            options: { shouldCreateUser: false, emailRedirectTo: `${location.origin}${href("/")}` },
          });
          if (error) throw new Error("Non è stato possibile inviare il link. Controlla l'indirizzo e riprova.");
          say("Controlla la tua email: ti abbiamo inviato il link di accesso.");
        });
      });
    }
  </script>
</AppLayout>
