---
/**
 * Corsi — the owner's home page. One card per course in the programme, grouped
 * by month, with the month's accent. The list is static HTML built from the
 * public site's content (src/lib/programma.ts); after the login guard the
 * script fetches `signups` and fills each card's counts. A sign-up whose
 * `event_id` matches no course goes under "Altre iscrizioni", so nothing is lost.
 */
import AppLayout from "../layouts/AppLayout.astro";
import { asDate, loadCourses } from "../lib/programma";
import { MINIMO_DEFAULT } from "../lib/corsi";

const courses = await loadCourses();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const monthFmt = new Intl.DateTimeFormat("it-IT", { month: "long", year: "numeric" });

const months = [...new Set(courses.map((c) => c.monthKey))].map((key) => ({
  key,
  label: monthFmt.format(asDate(`${key}-01`)),
  courses: courses.filter((c) => c.monthKey === key),
}));
---

<AppLayout title="Corsi" active="corsi" eyebrow="Programma">
  <p class="muted">
    I corsi in calendario sul sito, con chi si è iscritto dal modulo. Apri un corso per vedere i nomi e
    cambiare lo stato di ogni iscrizione.
  </p>

  {months.map((m) => (
    <section class="section corsi-section" data-month={m.courses[0]?.month}>
      <h2 class="day-title corsi-month">{m.label}</h2>
      <ul class="list">
        {m.courses.map((c) => (
          <li class="card corso" data-month={c.month} data-last-day={c.lastDay} data-course-id={c.id}
            data-aliases={c.aliases.join(" ")} data-capacity={c.capacity ?? ""}>
            <div class="row">
              <a class="corso-link" href={`${base}/corsi/${c.id}/`}><strong>{c.title}</strong></a>
              <span class="pill past-pill" hidden>Concluso</span>
              <span class="pill new-pill" hidden></span>
            </div>
            <p class="muted" style="margin:.35rem 0 0">
              {c.dates.join(" + ")}{c.host && ` · con ${c.host}`}
            </p>
            <p class="corso-facts">
              <span><span class="muted">Iscritti</span> <span class="n-iscritti">…</span>{c.capacity != null && ` / ${c.capacity} posti`}</span>
              <span><span class="muted">Minimo</span> <span class="n-minimo">{MINIMO_DEFAULT ?? "da definire"}</span></span>
              {c.capacity == null && <span><span class="muted">Posti</span> da definire</span>}
              <span><span class="muted">In attesa</span> <span class="n-attesa">…</span></span>
              {!c.free && <span><span class="muted">SumUp</span> <span class="n-sumup">…</span></span>}
              {c.free && <span>Gratuito</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="section" id="altre" hidden>
    <h2 class="day-title">Altre iscrizioni</h2>
    <p class="muted">Iscrizioni a un corso che non è (più) nel programma del sito.</p>
    <ul class="list" id="altre-list"></ul>
  </section>

  <p id="past-toggle" style="margin-top:1.5rem" hidden></p>

  <script>
    import { requireStaff } from "../lib/guard";
    import { data } from "../lib/data";
    import { MINIMO_DEFAULT, isActive } from "../lib/corsi";
    import { $, button, render, say } from "../lib/ui";
    import { attempt, signupItem } from "../lib/views";
    import type { SignupRow } from "../lib/types";

    const cards = [...document.querySelectorAll<HTMLElement>(".corso")];

    // The page was built on some earlier day: decide "past" in the browser.
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    const past = cards.filter((c) => (c.dataset.lastDay ?? "") < today);
    for (const card of past) {
      card.classList.add("past");
      card.querySelector<HTMLElement>(".past-pill")!.hidden = false;
    }
    // Upcoming first: past courses are hidden behind a button, and a month with
    // nothing left in it disappears with them.
    const showPast = (on: boolean) => {
      document.body.classList.toggle("show-past", on);
      for (const section of document.querySelectorAll<HTMLElement>(".corsi-section")) {
        section.hidden = !on && [...section.querySelectorAll(".corso")].every((c) => c.classList.contains("past"));
      }
    };
    if (past.length > 0) {
      const label = (on: boolean) => on ? "Nascondi i corsi conclusi" : `Mostra i corsi conclusi (${past.length})`;
      const btn = button(label(false), () => {
        const on = !document.body.classList.contains("show-past");
        showPast(on);
        btn.textContent = label(on);
      }, "secondary");
      render($("#past-toggle"), btn);
      $("#past-toggle").hidden = false;
      showPast(false);
    }

    // event_id → card (day 2 of a two-evening course points at day 1's card).
    const cardFor = new Map<string, HTMLElement>();
    for (const card of cards) for (const id of (card.dataset.aliases ?? "").split(" ")) if (id) cardFor.set(id, card);

    async function load() {
      const [rows, corsi] = await Promise.all([data.listSignups(), data.listCorsi()]);
      const withSumup = new Set(corsi.filter((c) => c.sumup_link).map((c) => c.event_id));
      const byCard = new Map<HTMLElement, SignupRow[]>();
      const orphans: SignupRow[] = [];
      for (const row of rows) {
        const card = cardFor.get(row.event_id);
        if (card) byCard.set(card, [...(byCard.get(card) ?? []), row]);
        else orphans.push(row);
      }

      for (const card of cards) {
        const list = byCard.get(card) ?? [];
        const active = list.filter(isActive).length;
        const waiting = list.filter((s) => s.status === "attesa").length;
        const fresh = list.filter((s) => s.status === "iscritta").length;
        card.querySelector<HTMLElement>(".n-iscritti")!.textContent = String(active);
        card.querySelector<HTMLElement>(".n-attesa")!.textContent = String(waiting);
        if (MINIMO_DEFAULT != null) {
          card.querySelector<HTMLElement>(".n-minimo")!.textContent =
            `${MINIMO_DEFAULT} · ${active >= MINIMO_DEFAULT ? "raggiunto" : `ne mancano ${MINIMO_DEFAULT - active}`}`;
        }
        const sumup = card.querySelector<HTMLElement>(".n-sumup");
        if (sumup) sumup.textContent = withSumup.has(card.dataset.courseId ?? "") ? "link inserito" : "da inserire";
        const pill = card.querySelector<HTMLElement>(".new-pill")!;
        pill.textContent = fresh === 1 ? "1 nuova" : `${fresh} nuove`;
        pill.hidden = fresh === 0;
      }

      $("#altre").hidden = orphans.length === 0;
      render($("#altre-list"), ...orphans.map((row) => signupItem(row, undefined, load)));
      say("");
    }

    void attempt(async () => {
      await requireStaff();
      await load();
    });
  </script>
</AppLayout>

<style>
  .corsi-month { color: var(--accent); text-transform: capitalize; }
  /* The month's Wada swatch as a stripe, like the date tiles on the site. */
  .corso { border-left: .4rem solid var(--tile); }
  .corso.past { opacity: .6; }
  :global(body:not(.show-past)) .corso.past { display: none; }
  .corso-link { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  .corso-facts { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: .5rem 0 0; }
</style>
