---
/**
 * Corsi — the owner's home page. One card per course in the programme, grouped
 * by month, with the month's accent. The list is static HTML built from the
 * public site's content (src/lib/programma.ts); after the login guard the
 * script fetches `signups` and fills each card's counts. A sign-up whose
 * `event_id` matches no course goes under "Altre iscrizioni", so nothing is lost.
 */
import AppLayout from "../layouts/AppLayout.astro";
import { asDate, loadCourses } from "../lib/programma";
import { MINIMO_DEFAULT } from "../lib/corsi";

const courses = await loadCourses();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const monthFmt = new Intl.DateTimeFormat("it-IT", { month: "long", year: "numeric" });

const months = [...new Set(courses.map((c) => c.monthKey))].map((key) => ({
  key,
  label: monthFmt.format(asDate(`${key}-01`)),
  courses: courses.filter((c) => c.monthKey === key),
}));
---

<AppLayout title="Corsi e iscritti" active="corsi" eyebrow="Programma">
  <p class="muted">
    I corsi in calendario sul sito, con chi si è iscritto dal modulo. Apri un corso per vedere i nomi, cambiare lo
    stato di ogni iscrizione, inserire il link SumUp e i tag.
  </p>

  <!-- What needs her attention, as filters. Filled after login. -->
  <section class="card filters" id="filters" hidden aria-label="Filtra i corsi">
    <div class="row" style="justify-content:flex-start;flex-wrap:wrap;gap:.5rem">
      <button type="button" class="btn secondary small" data-filter="all" aria-pressed="true">Tutti</button>
      <button type="button" class="btn secondary small" data-filter="new" aria-pressed="false">Iscrizioni nuove <span data-count="new"></span></button>
      <button type="button" class="btn secondary small" data-filter="nosumup" aria-pressed="false">Senza link SumUp <span data-count="nosumup"></span></button>
      <button type="button" class="btn secondary small" data-filter="notags" aria-pressed="false">Senza tag <span data-count="notags"></span></button>
      <button type="button" class="btn secondary small" data-filter="signups" aria-pressed="false">Con iscritti <span data-count="signups"></span></button>
    </div>
    <div class="row" style="justify-content:flex-start;flex-wrap:wrap;gap:.5rem;margin-top:.75rem">
      <input type="search" id="q" class="input" placeholder="Cerca un corso o un ospite" aria-label="Cerca un corso" style="width:auto;flex:1;min-width:12rem" />
      <select id="tag" class="input" aria-label="Filtra per tag" style="width:auto"><option value="">Tutti i tag</option></select>
    </div>
    <p class="muted" id="filter-empty" style="margin:.75rem 0 0" hidden>Nessun corso corrisponde ai filtri.</p>
  </section>

  {months.map((m) => (
    <section class="section corsi-section" data-month={m.courses[0]?.month}>
      <h2 class="day-title corsi-month">{m.label}</h2>
      <ul class="list">
        {m.courses.map((c) => (
          <li class="card corso" data-month={c.month} data-last-day={c.lastDay} data-course-id={c.id}
            data-aliases={c.aliases.join(" ")} data-capacity={c.capacity ?? ""} data-free={c.free ? "1" : ""}
            data-search={`${c.title} ${c.host ?? ""}`.toLowerCase()}>
            <div class="row">
              <a class="corso-link" href={`${base}/corsi/${c.id}/`}><strong>{c.title}</strong></a>
              <span class="pill past-pill" hidden>Concluso</span>
              <span class="pill new-pill" hidden></span>
            </div>
            <p class="muted" style="margin:.35rem 0 0">
              {c.dates.join(" + ")}{c.host && ` · con ${c.host}`}
            </p>
            <p class="corso-facts">
              <span><span class="muted">Iscritti</span> <span class="n-iscritti">…</span>{c.capacity != null && ` / ${c.capacity} posti`}</span>
              <span><span class="muted">Minimo</span> <span class="n-minimo">{MINIMO_DEFAULT ?? "da definire"}</span></span>
              {c.capacity == null && <span><span class="muted">Posti</span> da definire</span>}
              <span><span class="muted">In attesa</span> <span class="n-attesa">…</span></span>
              {!c.free && <span><span class="muted">SumUp</span> <span class="n-sumup">…</span></span>}
              {c.free && <span>Gratuito</span>}
            </p>
            <p class="corso-tags"></p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="section" id="altre" hidden>
    <h2 class="day-title">Altre iscrizioni</h2>
    <p class="muted">Iscrizioni a un corso che non è (più) nel programma del sito.</p>
    <ul class="list" id="altre-list"></ul>
  </section>

  <p id="past-toggle" style="margin-top:1.5rem" hidden></p>

  <script>
    import { requireStaff } from "../lib/guard";
    import { data } from "../lib/data";
    import { MINIMO_DEFAULT, isActive } from "../lib/corsi";
    import { $, button, el, render, say } from "../lib/ui";
    import { attempt, signupItem } from "../lib/views";
    import type { SignupRow } from "../lib/types";

    const cards = [...document.querySelectorAll<HTMLElement>(".corso")];

    // The page was built on some earlier day: decide "past" in the browser.
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    const past = cards.filter((c) => (c.dataset.lastDay ?? "") < today);
    for (const card of past) {
      card.classList.add("past");
      card.querySelector<HTMLElement>(".past-pill")!.hidden = false;
    }

    // -- filters ---------------------------------------------------------------
    // One function decides every card: past toggle + quick filter + search + tag.
    let showPast = false;
    let quick = "all";
    const matches = (card: HTMLElement) => {
      if (card.classList.contains("past") && !showPast) return false;
      if (quick !== "all" && card.dataset[quick] !== "1") return false;
      const q = ($("#q") as HTMLInputElement).value.trim().toLowerCase();
      if (q && !(card.dataset.search ?? "").includes(q)) return false;
      const tag = ($("#tag") as HTMLSelectElement).value;
      if (tag && !(card.dataset.tags ?? "").split("|").includes(tag)) return false;
      return true;
    };
    function apply() {
      let shown = 0;
      for (const card of cards) { const on = matches(card); card.hidden = !on; if (on) shown++; }
      for (const section of document.querySelectorAll<HTMLElement>(".corsi-section")) {
        section.hidden = [...section.querySelectorAll<HTMLElement>(".corso")].every((c) => c.hidden);
      }
      $("#filter-empty").hidden = shown > 0;
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-filter]")) {
      b.addEventListener("click", () => {
        quick = b.dataset.filter ?? "all";
        for (const x of document.querySelectorAll<HTMLButtonElement>("[data-filter]")) x.setAttribute("aria-pressed", String(x === b));
        apply();
      });
    }
    $("#q").addEventListener("input", apply);
    $("#tag").addEventListener("change", apply);

    if (past.length > 0) {
      const label = (on: boolean) => on ? "Nascondi i corsi conclusi" : `Mostra i corsi conclusi (${past.length})`;
      const btn = button(label(false), () => {
        showPast = !showPast;
        btn.textContent = label(showPast);
        apply();
      }, "secondary");
      render($("#past-toggle"), btn);
      $("#past-toggle").hidden = false;
    }
    apply();

    // event_id → card (day 2 of a two-evening course points at day 1's card).
    const cardFor = new Map<string, HTMLElement>();
    for (const card of cards) for (const id of (card.dataset.aliases ?? "").split(" ")) if (id) cardFor.set(id, card);

    async function load() {
      const [rows, corsi] = await Promise.all([data.listSignups(), data.listCorsi()]);
      const byId = new Map(corsi.map((c) => [c.event_id, c]));
      const byCard = new Map<HTMLElement, SignupRow[]>();
      const orphans: SignupRow[] = [];
      for (const row of rows) {
        const card = cardFor.get(row.event_id);
        if (card) byCard.set(card, [...(byCard.get(card) ?? []), row]);
        else orphans.push(row);
      }

      const allTags = new Set<string>();
      for (const card of cards) {
        const list = byCard.get(card) ?? [];
        const active = list.filter(isActive).length;
        const waiting = list.filter((s) => s.status === "attesa").length;
        const fresh = list.filter((s) => s.status === "iscritta").length;
        const corso = byId.get(card.dataset.courseId ?? "");
        const tags = corso?.tags ?? [];
        tags.forEach((t) => allTags.add(t));
        card.querySelector<HTMLElement>(".n-iscritti")!.textContent = String(active);
        card.querySelector<HTMLElement>(".n-attesa")!.textContent = String(waiting);
        if (MINIMO_DEFAULT != null) {
          card.querySelector<HTMLElement>(".n-minimo")!.textContent =
            `${MINIMO_DEFAULT} · ${active >= MINIMO_DEFAULT ? "raggiunto" : `ne mancano ${MINIMO_DEFAULT - active}`}`;
        }
        const sumup = card.querySelector<HTMLElement>(".n-sumup");
        if (sumup) sumup.textContent = corso?.sumup_link ? "link inserito" : "da inserire";
        render(card.querySelector<HTMLElement>(".corso-tags")!,
          ...(tags.length ? tags.map((t) => el("span", { class: "pill" }, t)) : [el("span", { class: "muted" }, "Senza tag")]));
        const pill = card.querySelector<HTMLElement>(".new-pill")!;
        pill.textContent = fresh === 1 ? "1 nuova" : `${fresh} nuove`;
        pill.hidden = fresh === 0;
        // Flags the quick filters read (data-new, data-nosumup, …). Past courses never count as "to do".
        const upcoming = !card.classList.contains("past");
        card.dataset.new = fresh > 0 ? "1" : "";
        card.dataset.nosumup = upcoming && !card.dataset.free && !corso?.sumup_link ? "1" : "";
        card.dataset.notags = tags.length === 0 ? "1" : "";
        card.dataset.signups = list.length > 0 ? "1" : "";
        card.dataset.tags = tags.join("|");
      }

      for (const key of ["new", "nosumup", "notags", "signups"]) {
        const n = cards.filter((c) => c.dataset[key] === "1" && (showPast || !c.classList.contains("past"))).length;
        $(`[data-count="${key}"]`).textContent = `(${n})`;
      }
      const select = $<HTMLSelectElement>("#tag");
      const chosen = select.value;
      render(select, el("option", { value: "" }, "Tutti i tag"),
        ...[...allTags].sort((a, b) => a.localeCompare(b, "it")).map((t) => el("option", { value: t, selected: t === chosen }, t)));
      $("#filters").hidden = false;
      apply();

      $("#altre").hidden = orphans.length === 0;
      render($("#altre-list"), ...orphans.map((row) => signupItem(row, undefined, load)));
      say("");
    }

    void attempt(async () => {
      await requireStaff();
      await load();
    });
  </script>
</AppLayout>

<style>
  .corsi-month { color: var(--accent); text-transform: capitalize; }
  /* The month's Wada swatch as a stripe, like the date tiles on the site. */
  .corso { border-left: .4rem solid var(--tile); }
  .corso.past { opacity: .6; }
  .corso-link { color: inherit; text-decoration: underline; text-underline-offset: .2em; }
  .corso-facts { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: .5rem 0 0; }
  .corso-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin: .5rem 0 0; }
  .corso[hidden], .corsi-section[hidden] { display: none; }
  .filters { margin: 1rem 0; }
  .filters [aria-pressed="true"] { background: var(--accent); color: var(--accent-contrast); border-color: var(--accent); }
</style>
