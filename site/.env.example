# Copy to `.env` (git-ignored). PUBLIC_ values are bundled into the page.

# `1` marks the build noindex and serves `Disallow: /` (a preview for the client).
# `pnpm build:site --amarti --demo` sets this for you.
PUBLIC_DEMO=

# Supabase project URL — the same as the app's. The contact form posts to
# `<URL>/functions/v1/request`. Leave empty to keep the `.example` placeholder,
# which can never resolve, so an unconfigured form fails loudly.
PUBLIC_SUPABASE_URL=
