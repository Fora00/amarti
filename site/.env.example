# Copy to `.env` (git-ignored). PUBLIC_ values are bundled into the page.

# `1` marks the build noindex and serves `Disallow: /` (a preview for the client).
# `pnpm build:site --amarti --demo` sets this for you.
PUBLIC_DEMO=

# Supabase project URL — the same as the app's. The contact form posts to
# `<URL>/functions/v1/request`, the event sign-up form to
# `<URL>/functions/v1/signup`. Leave empty to keep the `.example` placeholder,
# which can never resolve, so an unconfigured form fails loudly.
PUBLIC_SUPABASE_URL=

# The public (anon/publishable) key, same as the app's. The build reads the shop's
# price list (`listino`, visible rows only) with it. Never the service-role key.
PUBLIC_SUPABASE_ANON_KEY=
