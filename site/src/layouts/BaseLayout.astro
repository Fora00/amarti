---
import { Font } from "astro:assets";
import { url, isDemo } from "../lib/path.ts";
import Seo from "@factory/common/components/Seo.astro";
import JsonLd from "@factory/common/components/JsonLd.astro";
import { graph, baseGraph } from "@factory/common";
import type { JsonLdNode, SocialImage } from "@factory/common";

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, builtLocales } from "../site.config.ts";
import { i18n } from "../i18n/dictionaries.ts";
import { withLocalBusiness } from "../lib/business.ts";
import "../styles/global.css";

/**
 * The only place `<head>` is assembled. Threads the site config into `<Seo>`
 * once so pages never touch it — a page hand-writing a canonical is the bug
 * this exists to avoid.
 */
interface Props {
  title: string;
  description?: string;
  /** Suppress the site-name suffix. The home page sets this. */
  bareTitle?: boolean;
  /** Extra JSON-LD nodes, appended to the organization + website base. */
  jsonLd?: JsonLdNode[];
  /** Open Graph image for this page. Falls back to `site.defaultImage`. */
  image?: SocialImage;
  /** Keep this page out of search indexes — feeds `<meta name="robots">`. */
  noindex?: boolean;
}

const { title, description, bareTitle = false, jsonLd = [], image, noindex = false } = Astro.props;

const locale = i18n.localeFrom(Astro.url.pathname);
const { path } = i18n.stripLocale(Astro.url.pathname);
const t = i18n.useTranslations(locale);

// Only locales this site actually published — never the full supported list.
const alternates = i18n.getAlternates(path, [...builtLocales]);
---

<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- Light unless the visitor chose dark with the header toggle (ThemeToggle.astro). Before paint, so no flash. -->
    <script is:inline>try{if(localStorage.getItem("amarti-theme")==="dark")document.documentElement.dataset.theme="dark"}catch{}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!isDemo && <link rel="sitemap" href={url("/sitemap-index.xml")} />}
    <!-- Her logo, generated by `pnpm --filter amarti favicon`. /favicon.ico is
         what browsers ask for by default; the SVG wins where supported. Through
         url() so they survive a base path. -->
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <Font cssVariable="--font-caveat" preload />

    <Seo
      site={site}
      title={title}
      description={description}
      image={image}
      locale={locale}
      alternates={alternates}
      bareTitle={bareTitle}
      noindex={noindex || isDemo}
    />

    <JsonLd data={graph(...withLocalBusiness(baseGraph(site, locale)), ...jsonLd)} />
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only-focusable">{t("nav.skip")}</a>
    <SiteHeader />
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
