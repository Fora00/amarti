---
/**
 * The owner has not given prices yet (posters say "info in DM"), and the user
 * asked for a visible "00" box rather than a guess. Never render "Gratuito"
 * for a missing price — see `free` in content.config.ts.
 */
interface Props {
  label: string;
  compact?: boolean;
}
const { label, compact = false } = Astro.props;
---

<span class="inline-flex items-center gap-2">
  <span
    aria-hidden="true"
    class:list={[
      "rounded-md border-2 border-dashed border-line-strong font-display leading-none text-ink-muted",
      compact ? "px-1.5 py-0.5 text-lg" : "px-2.5 py-1 text-3xl",
    ]}>€ 00</span
  >
  <span class:list={["text-ink-muted", compact ? "text-sm" : ""]}>{label}</span>
</span>
