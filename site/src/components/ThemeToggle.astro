---
/**
 * Light / dark switch. The site is LIGHT by default (the <html> carries
 * `data-theme="light"`, which beats the system setting in theme.css); dark is
 * only ever chosen here, and remembered in localStorage under `amarti-theme`
 * (shared with the private app, same origin). The head script in BaseLayout
 * applies a stored choice before first paint.
 *
 * JS exception (plan/DECISIONS.md 2026-11-27), progressive enhancement: the
 * button is `hidden` until the script runs, so without JS the page is simply
 * light and nothing is broken.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle hidden aria-pressed="false" aria-label="Tema scuro" title="Tema scuro">
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
</button>

<script is:inline>
  (() => {
    const b = document.querySelector("[data-theme-toggle]");
    if (!b) return;
    const root = document.documentElement;
    const sync = () => b.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
    b.hidden = false;
    sync();
    b.addEventListener("click", () => {
      const dark = root.dataset.theme !== "dark";
      root.dataset.theme = dark ? "dark" : "light";
      try { localStorage.setItem("amarti-theme", dark ? "dark" : "light"); } catch {}
      sync();
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--ink-muted); cursor: pointer;
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .theme-toggle:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .sun { display: none; }
  :global(:root[data-theme="dark"]) .sun { display: block; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
</style>
