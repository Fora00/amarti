---
import { useLocale, localUrl } from "../lib/locale.ts";
import Container from "@factory/design-system/components/Container.astro";

import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Flag from "./Flag.astro";
import { site, instagramDm } from "../site.config.ts";

const { t, href, lang, path } = useLocale(Astro);

const links = [
  { href: href("/eventi/"), label: t("nav.events") },
  { href: href("/servizi/"), label: t("nav.services") },
  { href: href("/negozio/"), label: t("nav.shop") },
  { href: href("/chi-sono/"), label: t("nav.about") },
];
// The same page in the other language (every public page exists in both).
const other = lang === "it" ? "en" : "it";
const linkClass = "text-sm font-semibold text-ink-muted no-underline hover:text-accent aria-[current=page]:text-accent";
---

<header class="border-b border-line">
  <Container>
    <nav class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3" aria-label={t("nav.main")}>
      <div class="flex items-center gap-3">
        <a href={href("/")} class="flex items-center gap-3 text-ink no-underline">
          <Logo class="h-7 w-auto" />
          <span class="sr-only">{site.name} — {t("nav.home")}</span>
        </a>
        <ThemeToggle />
      </div>

      <ul class="flex list-none flex-wrap items-center gap-x-5 gap-y-2 p-0">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class={linkClass} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <!-- A plain link styled like the others (ExternalLink forces an underline). -->
          <a href={instagramDm} class={linkClass} target="_blank" rel="noopener noreferrer">{t("nav.write")} ↗</a>
        </li>
        <li>
          <a href={localUrl(path, other)} hreflang={other} lang={other} class:list={[linkClass, "inline-flex items-center gap-1.5"]}>
            <Flag lang={other} class="h-3.5 w-auto" />
            <span aria-hidden="true">{other.toUpperCase()}</span>
            <span class="sr-only">{t("nav.otherLanguage")}</span>
          </a>
        </li>
      </ul>
    </nav>
  </Container>
</header>
