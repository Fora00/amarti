---
/**
 * Her wordmark "aMarti", redrawn by hand as thin strokes from a screenshot the
 * user supplied (2026-11-20): round single-storey "a", a tall two-arch "M",
 * thin "rti". Inline SVG in `currentColor`: no request, no font, sharp at any
 * size, and it takes the colour of whatever it sits on. A tracing, not her
 * file — swap in the original SVG when she sends it.
 *
 * The strokes live in `src/lib/logo.ts`, shared with the favicons.
 */
import { LOGO_VIEWBOX, logoMarkup } from "../lib/logo.ts";

interface Props {
  /** `ring` adds the thin circle of her round Instagram logo. */
  variant?: "wordmark" | "ring";
  class?: string;
  /** Accessible name. Omit when the surrounding link already names the site. */
  label?: string;
}
const { variant = "wordmark", class: className, label } = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };

const svg = logoMarkup();
---

{
  variant === "ring" ? (
    <span
      class:list={["inline-grid shrink-0 place-items-center rounded-full border border-current", className]}
      {...a11y}
    >
      <svg viewBox={LOGO_VIEWBOX} class="w-[70%]" aria-hidden="true" set:html={svg} />
    </span>
  ) : (
    <svg viewBox={LOGO_VIEWBOX} class={className} {...a11y} set:html={svg} />
  )
}
