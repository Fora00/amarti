---
import { useLocale } from "../lib/locale.ts";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import Card from "@factory/design-system/components/Card.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import { resolveTiming } from "@factory/common/calendar";

import DateTile from "./DateTile.astro";
import { dateTile, eventTitle, formatClock, formatWhen } from "../lib/when.ts";
import { formatPrice } from "../lib/price.ts";

interface Props {
  event: CollectionEntry<"eventi">;
  /** Heading level, so the card fits whatever outline the page already has. */
  level?: 2 | 3;
}

const { event, level = 3 } = Astro.props;
const { t, href, lang, intl } = useLocale(Astro);
const { data } = event;
const { startIso } = resolveTiming(data);
const clock = formatClock(data, intl);
// The month's accent (global.css `[data-month]`) colours the tile and the time line.
const { monthNumber } = dateTile(data, intl);
// The card is one big link, so the guest is a name here; the Instagram link
// lives on the event page (no nested <a>).
const host = data.host ? await getEntry(data.host) : undefined;
---

<Card as="li" href={href(`/eventi/${event.id}/`)} tone="raised" padding="sm">
  <div class="flex items-start gap-4" data-month={monthNumber}>
    <DateTile timing={data} />
    <div class="flex min-w-0 flex-col gap-1">
      <p class="text-sm font-semibold text-accent">
        <time datetime={startIso}><span class="sr-only">{formatWhen(data, intl)}</span><span aria-hidden="true">{clock}</span></time>
        {data.status !== "scheduled" && <span> · {t(`events.status.${data.status}`)}</span>}
        {data.soldOut && data.status === "scheduled" && <span> · {t("events.soldOut")}</span>}
        {data.serie && <span> · {t("events.serieDay", { day: data.serie.day, of: data.serie.of })}</span>}
      </p>
      <Heading level={level} size="lg" class="text-heading! text-balance">{eventTitle(data, lang)}</Heading>
      {host && <p class="text-ink-muted">{t("events.with", { host: host.data.name })}</p>}
      {/* No price and not free = nothing shown (every field is optional). */}
      {
        (data.price || data.free) && (
          <p class="mt-1 font-semibold">{data.price ? formatPrice(data.price, intl) : t("events.free")}</p>
        )
      }
    </div>
  </div>
</Card>
