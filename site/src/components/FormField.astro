---
/** Label + control, label always visible and tied to the input by `for`. */
interface Props {
  id: string;
  label: string;
  type?: "text" | "tel" | "email" | "number";
  required?: boolean;
  multiline?: boolean;
  autocomplete?: string;
  maxlength?: number;
  /** One line of help under the label, announced with the control. */
  hint?: string;
  rows?: number;
  min?: number;
  max?: number;
  step?: number | string;
  inputmode?: "decimal" | "numeric" | "text" | "tel" | "email";
}
const {
  id, label, type = "text", required = false, multiline = false, autocomplete, maxlength,
  hint, rows = 3, min, max, step, inputmode,
} = Astro.props;
const control =
  "w-full min-h-11 rounded-lg border border-line-strong bg-surface-raised px-3 py-2.5 text-ink";
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="grid gap-1">
  <label for={id} class="text-sm font-semibold text-ink">
    {label}{required && <span aria-hidden="true"> *</span>}
  </label>
  {hint && <p id={hintId} class="text-sm text-ink-muted">{hint}</p>}
  {
    multiline ? (
      <textarea id={id} name={id} rows={rows} required={required} maxlength={maxlength} aria-describedby={hintId} class={control} />
    ) : (
      <input
        id={id} name={id} type={type} required={required} autocomplete={autocomplete} maxlength={maxlength}
        min={min} max={max} step={step} inputmode={inputmode} aria-describedby={hintId} class={control}
      />
    )
  }
</div>
