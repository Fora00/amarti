---
import { useLocale } from "../../lib/locale.ts";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import Container from "@factory/design-system/components/Container.astro";
import Section from "@factory/design-system/components/Section.astro";
import Stack from "@factory/design-system/components/Stack.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import { breadcrumbsLd } from "@factory/common";
import { monthGrid, resolveTiming } from "@factory/common/calendar";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { monthPaths } from "../../lib/paths.ts";
import EventCard from "../../components/EventCard.astro";
import { eventTitle, monthLabel, weekdayLabels } from "../../lib/when.ts";
import { site } from "../../site.config.ts";

interface Props {
  events: CollectionEntry<"eventi">[];
  previous?: string;
  next?: string;
}

export const getStaticPaths: GetStaticPaths = monthPaths;

// `[month]` is a required param, so it is always present here.
const month = Astro.params.month as string;
const { events, previous, next } = Astro.props;
const { t, href, lpath, lang, intl } = useLocale(Astro);

const label = monthLabel(month, intl);
// "2026-11" → 11: global.css `[data-month]` gives each month its own accent.
const monthNumber = Number(month.slice(5, 7));
const weeks = monthGrid(month);
const weekdays = weekdayLabels(intl);

// Events keyed by their local start date, for the grid cells.
const byDay = new Map<string, CollectionEntry<"eventi">[]>();
for (const event of events) {
  const day = resolveTiming(event.data).startDate;
  byDay.set(day, [...(byDay.get(day) ?? []), event]);
}

const jsonLd = [
  breadcrumbsLd(site, [
    { name: t("nav.home"), path: lpath("/") },
    { name: t("events.title"), path: lpath("/eventi/") },
    { name: label },
  ]),
];
---

<BaseLayout title={t("events.monthTitle", { month: label })} description={t("events.lead")} jsonLd={jsonLd}>
  <main id="main" data-month={monthNumber}>
    <Section space="md">
      <Container>
        <Stack gap="lg">
          {/* Like her monthly Instagram poster: the month's colour as the ground,
              big hand-lettered title in cream (design review 2026-11-27). */}
          <header class="rounded-card bg-tile px-6 py-8 text-tile-ink sm:px-10 sm:py-12">
            <Heading level={1} class="text-tile-ink! font-hand text-5xl/none sm:text-7xl/none">{t("events.monthTitle", { month: label })}</Heading>
            <nav class="mt-6 flex justify-between gap-4 text-sm font-semibold" aria-label={t("events.months")}>
              {previous ? <a class="text-tile-ink underline underline-offset-4 hover:no-underline" href={href(`/calendario/${previous}/`)}>← {monthLabel(previous, intl)}</a> : <span />}
              {next ? <a class="text-tile-ink underline underline-offset-4 hover:no-underline" href={href(`/calendario/${next}/`)}>{monthLabel(next, intl)} →</a> : <span />}
            </nav>
          </header>

          {/* A grid is unreadable on a phone, so it only appears from md up;
              the list below carries the same events at every width. */}
          <table class="hidden w-full table-fixed border-collapse md:table">
            <caption class="sr-only">{t("events.calendar", { month: label })}</caption>
            <thead>
              <tr>
                {weekdays.map((day) => (
                  <th scope="col" class="border border-line p-2 text-sm font-semibold capitalize">{day}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {weeks.map((week) => (
                <tr>
                  {week.map((cell) => (
                    <td class={`h-28 border border-line p-2 align-top ${!cell.inMonth ? "text-ink-muted" : byDay.has(cell.date) ? "bg-cell text-cell-ink" : ""}`}>
                      <span class="text-sm">{Number(cell.date.slice(8))}</span>
                      {cell.inMonth &&
                        (byDay.get(cell.date) ?? []).map((event) => (
                          <a href={href(`/eventi/${event.id}/`)} class="mt-1 block text-xs font-semibold">
                            {eventTitle(event.data, lang)}
                          </a>
                        ))}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>

          <Stack as="ul" gap="md" class="list-none p-0">
            {events.map((event) => <EventCard event={event} level={2} />)}
          </Stack>
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
