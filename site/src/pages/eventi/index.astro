---
import { useLocale } from "../../lib/locale.ts";
import { getCollection } from "astro:content";
import { url } from "../../lib/path.ts";
import Container from "@factory/design-system/components/Container.astro";
import Section from "@factory/design-system/components/Section.astro";
import Stack from "@factory/design-system/components/Stack.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import { breadcrumbsLd } from "@factory/common";
import { groupByMonth, isUpcoming } from "@factory/common/calendar";

import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import TagFilter from "../../components/TagFilter.astro";
import { loadCourseTags, tagsIn } from "../../lib/tags.ts";
import { monthLabel } from "../../lib/when.ts";
import { site } from "../../site.config.ts";

const { t, href, lpath, intl } = useLocale(Astro);

const all = await getCollection("eventi");
const upcoming = groupByMonth(
  all.filter((event) => isUpcoming(event.data)),
  (event) => event.data,
);
// Kinds of workshop that have something coming up: the filter links.
const filterTags = tagsIn(all.filter((event) => isUpcoming(event.data)), await loadCourseTags());
// Every month with an event, including past ones, for the calendar pages.
const months = [...groupByMonth(all, (event) => event.data).keys()];

const jsonLd = [
  breadcrumbsLd(site, [{ name: t("nav.home"), path: lpath("/") }, { name: t("events.title") }]),
];
---

<BaseLayout title={t("events.title")} description={t("events.lead")} jsonLd={jsonLd}>
  <main id="main">
    <Section space="md">
      <Container>
        <Stack gap="lg">
          <Stack gap="sm">
            <Heading level={1} class="text-heading! font-display">{t("events.title")}</Heading>
            <p class="max-w-reading text-lg text-ink-muted text-pretty">{t("events.lead")}</p>
          </Stack>

          <TagFilter tags={filterTags} />

          {upcoming.size === 0 && <p class="text-ink-muted">{t("events.empty")}</p>}

          {
            [...upcoming].map(([key, events]) => (
              <Stack gap="md">
                <Heading level={2} size="xl" class="text-heading! font-display capitalize">
                  <a href={href(`/calendario/${key}/`)} class="no-underline hover:underline">
                    {monthLabel(key, intl)}
                  </a>
                </Heading>
                <Stack as="ul" gap="md" class="list-none p-0">
                  {events.map((event) => <EventCard event={event} />)}
                </Stack>
              </Stack>
            ))
          }

          {
            months.length > 0 && (
              <nav aria-label={t("events.months")}>
                <Heading level={2} size="md">{t("events.months")}</Heading>
                <ul class="mt-3 flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
                  {months.map((key) => (
                    <li>
                      <a href={href(`/calendario/${key}/`)}>{monthLabel(key, intl)}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <p>
            <a href={url("/calendario.ics")}>{t("events.subscribe")}</a>
          </p>
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
