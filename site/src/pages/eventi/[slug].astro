---
import { useLocale } from "../../lib/locale.ts";
import type { GetStaticPaths } from "astro";
import { url } from "../../lib/path.ts";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import Container from "@factory/design-system/components/Container.astro";
import Section from "@factory/design-system/components/Section.astro";
import Stack from "@factory/design-system/components/Stack.astro";
import Prose from "@factory/design-system/components/Prose.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import Button from "@factory/design-system/components/Button.astro";
import ExternalLink from "@factory/design-system/components/ExternalLink.astro";
import { eventLd, breadcrumbsLd, faqPageLd } from "@factory/common";
import { isUpcoming, resolveTiming } from "@factory/common/calendar";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventPaths } from "../../lib/paths.ts";
import { loadCourseTags, tagLabel, tagSlug, tagsOf } from "../../lib/tags.ts";
import DateTile from "../../components/DateTile.astro";
import SignupForm from "../../components/SignupForm.astro";
import { dateTile, eventLead, eventSummary, eventTitle, formatWhen } from "../../lib/when.ts";
import { formatPrice } from "../../lib/price.ts";
import { site } from "../../site.config.ts";

/** Astro types `Astro.props` from this interface; without it `event` is `unknown`. */
interface Props {
  event: CollectionEntry<"eventi">;
}

export const getStaticPaths: GetStaticPaths = eventPaths;

const { event } = Astro.props;
const { t, href, lpath, lang, intl } = useLocale(Astro);
const { Content } = await render(event);

const { data } = event;
const path = `/eventi/${event.id}/`;
const { startIso } = resolveTiming(data);
const description = eventSummary(data, lang);
const title = eventTitle(data, lang);
const lead = eventLead(data, lang);
// Every field but title and date is optional: a row of facts shows only what is set.
const priceText = data.price ? formatPrice(data.price, intl) : data.free ? t("events.free") : undefined;

// Instagram cannot prefill a DM, so the button copies this to the clipboard and
// the visitor pastes it into the chat. Needs the one inline script below.
const copyMessage =
  data.bookingProvider === "instagram" && data.bookingUrl
    ? t("events.bookingMessage", { title, when: formatWhen(data, intl) })
    : undefined;
// Day 2 of a two-evening course is booked with day 1, so only day 1 books.
const laterDay = Boolean(data.serie && data.serie.day > 1);
const bookable = Boolean(data.bookingUrl) && data.status === "scheduled" && !data.soldOut && !laterDay && isUpcoming(data);
// The free sign-up form (→ `signups`, see backend/supabase/functions/signup).
// Not on day 2+, not once the event is over (decided at build time: a rebuild
// removes it), not when cancelled, postponed or sold out. Instagram stays as the
// secondary path, and the demo "Paga e prenota" goes: payment now comes only
// after Martina confirms the course (plan/BOOKING-FLOW.md, 2026-11-26).
const signupOpen = data.status === "scheduled" && !data.soldOut && !laterDay && isUpcoming(data);
const host = data.host ? await getEntry(data.host) : undefined;
// `reference()` does not check that the id exists: getEntry just returns
// undefined and the guest would vanish silently. Fail the build instead.
if (data.host && !host) throw new Error(`${event.id}: host "${data.host.id}" is not in src/content/ospiti.yaml`);
const other = data.serie ? await getEntry(data.serie.with) : undefined;
// Links to the filter pages, which exist only for tags with upcoming courses: an upcoming event's tags always have one.
const tags = tagsOf(event, await loadCourseTags());
const tagLinks = isUpcoming(data);
if (data.serie && !other) throw new Error(`${event.id}: serie.with points at a missing event`);

const jsonLd = [
  eventLd(site, {
    name: title,
    description,
    path: lpath(path),
    timing: data,
    status: data.status,
    location: data.location,
    price: data.price,
    bookingUrl: data.bookingUrl,
    soldOut: data.soldOut,
  }),
  breadcrumbsLd(site, [
    { name: t("nav.home"), path: lpath("/") },
    { name: t("events.title"), path: lpath("/eventi/") },
    { name: title },
  ]),
  ...(data.faq.length > 0 ? [faqPageLd(data.faq)] : []),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={data.noindex}>
  <main id="main">
    <Section space="md">
      <Container width="reading" as="article">
        <Stack gap="lg">
          <Stack gap="sm">
            <div class="flex items-center gap-5" data-month={dateTile(data, intl).monthNumber}>
              <DateTile timing={data} size="lg" />
              <p class="font-semibold text-accent">
                <time datetime={startIso}>{formatWhen(data, intl)}</time>
                {data.status !== "scheduled" && <span> · {t(`events.status.${data.status}`)}</span>}
                {data.serie && <span class="block text-ink-muted">{t("events.serieDay", { day: data.serie.day, of: data.serie.of })}</span>}
              </p>
            </div>
            <Heading level={1} size="title" class="text-heading! font-hand text-balance">{title}</Heading>
            {
              host && (
                <p class="text-lg font-semibold">
                  {t("events.withLabel")}{" "}
                  {host.data.instagram ? (
                    <ExternalLink href={`https://www.instagram.com/${host.data.instagram}/`}>
                      {host.data.name} <span class="font-normal text-ink-muted">@{host.data.instagram}</span>
                    </ExternalLink>
                  ) : (
                    host.data.name
                  )}
                </p>
              )
            }
            {lead && <p class="text-lg text-ink-muted text-pretty">{lead}</p>}
            {
              tags.length > 0 && (
                <ul class="flex list-none flex-wrap gap-2 p-0">
                  {tags.map((tag) => (
                    <li>
                      {tagLinks ? (
                        <a href={href(`/eventi/tag/${tagSlug(tag)}/`)} class="inline-flex rounded-pill border border-line-strong px-3 py-1 text-sm font-semibold text-ink no-underline hover:border-accent">
                          {tagLabel(tag, lang)}
                        </a>
                      ) : (
                        <span class="inline-flex rounded-pill bg-surface-muted px-3 py-1 text-sm font-semibold text-ink-muted">{tagLabel(tag, lang)}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )
            }
            {
              data.serie && other && (
                <p class="rounded-card border border-line bg-surface-muted px-4 py-3">
                  {t(other.data.serie!.day > data.serie.day ? "events.serieNext" : "events.seriePrevious", {
                    day: other.data.serie!.day,
                  })}{" "}
                  <a href={href(`/eventi/${other.id}/`)}>{formatWhen(other.data, intl)}</a>
                </p>
              )
            }
          </Stack>

          {
            data.cover && (
              <Image
                src={data.cover}
                alt={data.coverAlt ?? ""}
                width={960}
                height={540}
                widths={[480, 960]}
                sizes="(min-width: 768px) 42rem, 100vw"
                class="w-full rounded-card"
              />
            )
          }
          {
            (data.location || priceText || data.capacity) && (
          <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr]">
            {
              data.location && (
                <>
                  <dt class="font-semibold">{t("events.where")}</dt>
                  <dd>
                    {data.location.name}
                    {data.location.address && <span class="text-ink-muted"> — {data.location.address}</span>}
                  </dd>
                </>
              )
            }
            {
              priceText && (
                <>
                  <dt class="font-semibold">{t("events.price")}</dt>
                  <dd>{priceText}</dd>
                </>
              )
            }
            {
              data.capacity && (
                <>
                  <dt class="font-semibold">{t("events.seats")}</dt>
                  <dd>{data.capacity}</dd>
                </>
              )
            }
          </dl>
            )
          }

          {/* Design review 2026-11-27: ONE action. With the sign-up form open, the
              button goes to the form and Instagram lives as a text link inside it;
              the calendar is a text link. */}
          <Stack direction="row" gap="sm" wrap align="center">
            {signupOpen && <Button href="#prenota" size="lg">{t("signup.cta")}</Button>}
            {
              bookable && !signupOpen && data.bookingUrl && (
                <Button
                  href={data.bookingUrl}
                  external={data.bookingUrl.startsWith("http")}
                  data-copy={copyMessage}
                >
                  {t(`events.book.${data.bookingProvider}`)}
                </Button>
              )
            }
            {
              // Demo only: online payment is not decided yet (plan/BOOKING-FLOW.md).
              // A plain disabled <button> (the design-system Button does not type `disabled`),
              // so it cannot be followed or focused by mistake.
              bookable && !data.free && !signupOpen && (
                <button
                  type="button"
                  disabled
                  class="inline-flex cursor-not-allowed items-center justify-center rounded-pill border border-line-strong bg-surface-muted px-5 py-2.5 font-semibold text-ink-muted opacity-60"
                >
                  {t("events.pay")}
                </button>
              )
            }
            {
              data.soldOut && data.status === "scheduled" && (
                <p class="rounded-pill bg-surface-muted px-5 py-2.5 font-semibold">{t("events.soldOut")}</p>
              )
            }
          </Stack>
          <p class="-mt-3 text-sm">
            <a href={url(`/eventi/${event.id}.ics`)} class="font-semibold text-accent underline underline-offset-4">{t("events.addToCalendar")}</a>
          </p>

          {bookable && !data.free && !signupOpen && <p class="text-sm text-ink-muted">{t("events.payDemo")}</p>}
          {laterDay && <p class="text-ink-muted">{t("events.serieBookFirst")}</p>}

          {
            bookable && !signupOpen && copyMessage && (
              <>
                {/* Shown by the script, so it never promises a copy that cannot happen. */}
                <p class="text-sm text-ink-muted" data-copy-hint hidden>
                  {t("events.copyHint")}
                </p>
                <p
                  class="text-sm font-semibold text-accent"
                  role="status"
                  data-copy-status
                  data-copied={t("events.copied")}
                />
                {/* Inline on purpose: an external file would be a second request.
                    Progressive enhancement — without it the button is a plain link. */}
                <script is:inline>
                  (function () {
                    if (!navigator.clipboard) return;
                    var link = document.querySelector("a[data-copy]");
                    var status = document.querySelector("[data-copy-status]");
                    var hint = document.querySelector("[data-copy-hint]");
                    if (!link || !status) return;
                    if (hint) hint.hidden = false;
                    link.addEventListener("click", function () {
                      navigator.clipboard.writeText(link.dataset.copy).then(function () {
                        status.textContent = status.dataset.copied;
                      });
                    });
                  })();
                </script>
              </>
            )
          }

          {/* The Markdown body is written in Italian only: left out of /en/ rather than shown untranslated. */}
          {lang === "it" && event.body?.trim() && <Prose><Content /></Prose>}

          {signupOpen && <SignupForm eventId={event.id} />}
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
