---
import Container from "@factory/design-system/components/Container.astro";
import Section from "@factory/design-system/components/Section.astro";
import Stack from "@factory/design-system/components/Stack.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import Button from "@factory/design-system/components/Button.astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { i18n } from "../../i18n/dictionaries.ts";
import { url } from "../../lib/path.ts";

const t = i18n.useTranslations("it");
---

<!-- Where the `signup` edge function redirects after a course sign-up (same
     pattern as /grazie/). Nothing to rank for. -->
<BaseLayout title={t("signupThanks.title")} noindex>
  <main id="main">
    <Section space="md">
      <Container width="reading">
        <Stack gap="md" align="start">
          <Heading level={1}>{t("signupThanks.title")}</Heading>
          <p class="text-lg text-pretty">{t("signupThanks.lead")}</p>
          <p class="text-ink-muted text-pretty">{t("signupThanks.next")}</p>
          <p class="text-ink-muted text-pretty">{t("signupThanks.pay")}</p>
          <Button href={url("/eventi/")}>{t("signupThanks.back")}</Button>
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
