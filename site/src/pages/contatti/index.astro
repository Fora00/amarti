---
import Container from "@factory/design-system/components/Container.astro";
import Section from "@factory/design-system/components/Section.astro";
import Stack from "@factory/design-system/components/Stack.astro";
import Heading from "@factory/design-system/components/Heading.astro";
import Button from "@factory/design-system/components/Button.astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import FormField from "../../components/FormField.astro";
import { forms } from "../../forms.ts";
import { i18n } from "../../i18n/dictionaries.ts";

const t = i18n.useTranslations("it");
---

<BaseLayout italianOnly title={t("contact.title")} description={t("contact.lead")}>
  <main id="main">
    <Section space="md">
      <Container width="reading">
        <Stack gap="md">
          <Heading level={1}>{t("contact.title")}</Heading>
          <p class="text-ink-muted text-pretty">{t("contact.lead")}</p>

          <!-- Shown only when the server sent us back here with #errore (CSS :target,
               no JavaScript). `role=alert` + the anchor scroll put it in front of the visitor. -->
          <p id="errore" role="alert" class="hidden rounded-lg border border-accent bg-accent-muted p-4 font-semibold text-ink target:block">
            {t("form.error")}
          </p>

          <!-- Plain POST, zero JS: the edge function stores the message and
               answers with a redirect to /grazie/. A rejected submit redirects
               back here with #errore, which the banner above reacts to. -->
          <form method="post" action={forms.request} class="grid gap-5">
            <FormField id="nome" label={t("contact.name")} required autocomplete="name" maxlength={120} />
            <FormField id="email" label={t("contact.email")} type="email" required autocomplete="email" maxlength={160} />
            <FormField id="telefono" label={t("contact.phone")} type="tel" autocomplete="tel" maxlength={40} />
            <FormField id="messaggio" label={t("contact.message")} multiline required maxlength={2000} />

            <!-- Honeypot: humans never see it; a bot that fills it is dropped. -->
            <div class="sr-only" aria-hidden="true">
              <label>Non compilare <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>

            <Stack direction="row" gap="sm" align="center" wrap>
              <Button type="submit" size="lg">{t("contact.submit")}</Button>
            </Stack>
            <p class="text-sm text-ink-muted">{t("contact.privacy")} {t("contact.fallback")}</p>
          </form>
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
